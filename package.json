{
  "name": "ap-quiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "応用情報技術者試験の診断クイズ（迷いログ付き）",
  "scripts": {
    "build:questions": "node scripts/build-questions.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute ap-quiz --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute ap-quiz --remote --file=./schema.sql",
    "typecheck": "node scripts/build-questions.mjs && tsc --noEmit",
    "test": "node scripts/build-questions.mjs && vitest run"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
